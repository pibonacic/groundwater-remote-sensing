// Autor: Pedro Bonacic Vera\
\
//---------------------------------------------------------------------------//\
// IMPORTACIONES\
//---------------------------------------------------------------------------//\
\
// Colecciones satelitales\
var s2 = ee.ImageCollection("COPERNICUS/S2_SR_HARMONIZED");\
var csPlus = ee.ImageCollection("GOOGLE/CLOUD_SCORE_PLUS/V1/S2_HARMONIZED");\
\
\
//---------------------------------------------------------------------------//\
// DEFINICION DE VARIABLES AUXILIARES\
//---------------------------------------------------------------------------//\
\
var SDH1PS01 = ee.Geometry.Point([-68.86436, -20.26589]);\
\
// Fechas\
var startDate = '2024-05-20';\
var endDate = '2026-06-01';\
\
// Enmascaramiento de nubes\
var cloudBand = 'cs_cdf';\
var cloudThresh = 0.6;\
\
// Muestreo aleatorio\
var nPoints = 30;\
var seedValue = 42;\
var polygon = geometry;\
\
// Bandas e indices objetivo\
var features = ['B2', 'B3', 'B4', 'B5', 'B6', 'B7', 'B8', 'B8A', 'B11', 'B12', \
                'ndvi', 'gndvi', 'ndwi', 'mndwi', 'ndmi', 'ndmi2', 'str',\
                'brightness', 'greenness', 'wetness'];\
\
\
//---------------------------------------------------------------------------//\
// DEFINICION DE FUNCIONES\
//---------------------------------------------------------------------------//\
\
//Filtrado por fecha y lugar\
function applyFilters(col, start, end, geometry, cloudProperty, maxCloud)\{\
  return col.filterDate(start, end)\
            .filterBounds(geometry)\
            .filter(ee.Filter.lt(cloudProperty, maxCloud));\
\}\
\
// Aplicacion de scale y offset\
function scaleSentinel2(img)\{\
  var bands = img.select('B.*').divide(10000);\
  return img.addBands(bands, null, true);\
\}\
\
// Enmascaramiento de nubes en Sentinel 2 con Cloud Score+\
function maskCloudsS2(img)\{\
  var score = img.select(cloudBand);\
  var mask = score.gte(cloudThresh);\
  return img.updateMask(mask);\
\}\
\
// Calculo de indices espectrales y transformaciones\
function computeIndices(img, green, red, nir, swir1, swir2)\{\
  var ndvi = img.normalizedDifference([nir, red]).rename('ndvi');\
  var gndvi = img.normalizedDifference([nir, green]).rename('gndvi');\
  var ndwi = img.normalizedDifference([green, nir]).rename('ndwi');\
  var mndwi = img.normalizedDifference([green, swir1]).rename('mndwi');\
  var ndmi = img.normalizedDifference([nir, swir1]).rename('ndmi');\
  var ndmi2 = img.normalizedDifference([nir, swir2]).rename('ndmi2');\
  \
  var str = img.expression(\
    '((1 - swir1)**2) / (2 * swir1)', \{\
      'swir1': img.select(swir1)\
    \}).rename('str');\
    \
  return img.addBands([ndvi, gndvi, ndwi, mndwi, ndmi, ndmi2, str]);\
\}\
\
// Calculo de TCT Sentinel-2 \
function computeS2TCT(img, blue, green, red, nir, swir1, swir2)\{\
  var bands = \{\
    'B': img.select(blue),\
    'G': img.select(green),\
    'R': img.select(red),\
    'N': img.select(nir),\
    'S1': img.select(swir1),\
    'S2': img.select(swir2)\
  \};\
  // Coeficientes de Shi & Xu (2019)\
  var brightness = img.expression(\
    '(B * 0.3510) + (G * 0.3813) + (R * 0.3437) + (N * 0.7196) + (S1 * 0.2396) + (S2 * 0.1949)', bands)\
    .rename('brightness');\
    \
  var greenness = img.expression(\
    '(B * -0.3599) + (G * -0.3533) + (R * -0.4734) + (N * 0.6633) + (S1 * 0.0087) + (S2 * -0.2856)', bands)\
    .rename('greenness');\
\
  var wetness = img.expression(\
    '(B * 0.2578) + (G * 0.2305) + (R * 0.0883) + (N * 0.1071) + (S1 * -0.7611) + (S2 * -0.5308)', bands)\
    .rename('wetness');\
  \
  return img.addBands([brightness, greenness, wetness]);\
\}\
\
// Generacion de puntos aleatorios\
function generateGridPoints(region, numPoints, seed, refImage) \{\
  \
  // Extrae la proyeccion de una banda de 20x20 m de sentinel 2\
  var s2Projection = refImage.select('B11').projection();\
  \
  // Crea una imagen constante con la proyeccion de sentinel 2\
  var constantImage = ee.Image.constant(1).reproject(\{\
    crs: s2Projection\
  \});\
  \
  // Muestreo en el centroide de px aleatorios de 20x20m\
  var sampledPoints = constantImage.sample(\{\
    region: region,\
    //projection: s2Projection,\
    scale: 20,\
    numPixels: numPoints,\
    seed: seed,\
    geometries: true\
  \});\
  \
  // Asignacion de ids a cada punto\
  var pointsList = sampledPoints.toList(numPoints);\
  var pointsWithId = ee.List.sequence(1, pointsList.size()).map(function(index) \{\
    var feature = ee.Feature(pointsList.get(ee.Number(index).subtract(1)));\
    var pointId = ee.String('p').cat(ee.Number(index).format('%02d'));\
    return feature.set('point_id', pointId);\
  \});\
  \
  return ee.FeatureCollection(pointsWithId);\
\}\
\
// Extraccion de los valores de banda en cada punto e imagen de la coleccion\
function extractTimeSeries(imageCollection, points, bands) \{\
  \
  var timeSeries = imageCollection.map(function(img) \{\
    var dateString = img.date().format('YYYY-MM-dd');\
    \
    // Extrae el valor de la banda en todos los puntos en la imagen actual\
    var extractedValues = img.select(bands).reduceRegions(\{\
      collection: points,\
      reducer: ee.Reducer.first(),\
      scale: 20\
    \});\
    \
    var sortedExtractedValues = extractedValues.sort('point_id');\
    var initialDict = ee.Dictionary(\{'Timestamps': dateString\});\
    \
    // Pivoteo de la tabla para ajustar formato\
    var rowDict = sortedExtractedValues.iterate(function(feature, currentDict) \{\
      feature = ee.Feature(feature);\
      currentDict = ee.Dictionary(currentDict);\
      var ptId = ee.String(feature.get('point_id'));\
      \
      // Formatea el nombre de las columnas\
      var keys = bands.map(function(bandName) \{\
        return ee.String(bandName).cat('_').cat(ptId);\
      \});\
      \
      // Asignacion de valores de las bandas a las columnas\
      var values = bands.map(function(bandName) \{\
        return feature.get(bandName);\
      \});\
      \
      var pointDict = ee.Dictionary.fromLists(keys, values);\
      return currentDict.combine(pointDict);\
    \}, initialDict);\
    \
    return ee.Feature(null, ee.Dictionary(rowDict));\
  \});\
  \
  return timeSeries;\
\}\
\
\
//---------------------------------------------------------------------------//\
// PROCESAMIENTO\
//---------------------------------------------------------------------------//\
\
// Filtrado de colecciones satelitales\
// Sentinel 2 no se filtra por nubosidad porque despues se aplica una mascara a las nubes (cloud score+)\
var s2filtered = applyFilters(s2, startDate, endDate, SDH1PS01, 'CLOUDY_PIXEL_PERCENTAGE', 100);\
\
// Escalado y union a coleccion con mascara de nubes\
var s2cs = s2filtered.map(scaleSentinel2)\
                     .linkCollection(csPlus, [cloudBand]);\
\
// Enmascaramiento de nubes\
var s2masked = s2cs.map(maskCloudsS2);\
\
// Calculo de indices y transformaciones\
var s2Indices = s2masked.map(function(img)\{\
  return computeIndices(img, 'B3', 'B4', 'B8', 'B11', 'B12');\
\});\
var s2TCT = s2Indices.map(function(img)\{\
  return computeS2TCT(img, 'B2', 'B3', 'B4', 'B8', 'B11', 'B12');\
\});\
\
// Seleccion de bandas e indices a exportar\
var s2selection = s2TCT.select(features);\
print('sentinel2 w/ indices and TCT', s2selection);\
\
// Generacion de puntos aleatorios\
var referenceImage = s2filtered.first();\
var randomPoints = generateGridPoints(polygon, nPoints, seedValue, referenceImage);\
\
// Extraccion de datos\
var featuresTable = extractTimeSeries(s2selection, randomPoints, features);\
print('First record:', featuresTable.first());\
\
// Generacion de una lista de selectores para mantener orden en exportacion\
var exportSelectors = ['Timestamps'];\
\
// Itera sobre cada indice\
for (var i = 0; i < features.length; i++) \{\
  var currentIndex = features[i];\
  \
  // Itera sobre cada punto desde 1 hasta n\
  for (var j = 1; j <= nPoints; j++) \{\
    var pointString = (j < 10) ? 'p0' + j : 'p' + j;\
    var columnHeader = currentIndex + '_' + pointString;\
    exportSelectors.push(columnHeader);\
  \}\
\}\
\
\
//---------------------------------------------------------------------------//\
// VISUALIZACION\
//---------------------------------------------------------------------------//\
\
// 2024-05-25: 1716649107640\
// 2024-11-06: 1730905101863\
// 2024-11-11: 1731337105927\
// 2025-01-05: 1736089107855\
var filterDate = 1736089107855;\
\
Map.addLayer(s2selection.filterDate(filterDate).first(), \{bands: ['B4', 'B3', 'B2'], min: 0, max: 0.6, gamma: 1\}, 'Sentinel-2 RGB (cloud masked)', false);\
Map.addLayer(s2cs.filterDate(filterDate).first(), \{bands: ['B4', 'B3', 'B2'], min: 0, max: 0.6, gamma: 1\}, 'Sentinel-2 RGB', false);\
Map.addLayer(randomPoints, \{color: 'blue'\}, 'Random sample points');\
Map.addLayer(SDH1PS01, \{color: 'red'\}, 'SDH1PS01');\
\
Map.centerObject(SDH1PS01, 14);\
\
\
//---------------------------------------------------------------------------//\
// EXPORTACION\
//---------------------------------------------------------------------------//\
\
// Exportar la tabla resultante a Google Drive en formato CSV\
Export.table.toDrive(\{\
  collection: featuresTable,\
  description: 'Sentinel2_bands_indices_TCT_20m_202405-202605',\
  fileFormat: 'CSV',\
  selectors: exportSelectors\
\});}